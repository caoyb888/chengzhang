root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java}]
indent_size = 4
max_line_length = 120

[*.{ts,tsx,vue,js,jsx}]
indent_size = 2
max_line_length = 100

[*.{yml,yaml}]
indent_size = 2

[*.{xml,html}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
